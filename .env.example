# =============================================================================
# rdp-in-browser — Production Environment Configuration
# =============================================================================
# Copy this file to `.env` and fill in all required values before deployment.
#
#   Windows: copy .env.example .env
#   Linux:   cp .env.example .env
#
# Generate secure secrets (32+ characters), for example:
#   Linux/macOS:   openssl rand -base64 48
#   PowerShell:    [Convert]::ToBase64String((1..48 | ForEach-Object { Get-Random -Maximum 256 }))
# =============================================================================

# --- Application ---
NODE_ENV=production

# Public HTTP port exposed by the frontend container (host port)
HTTP_PORT=80

# --- Backend API ---
PORT=3001

# SQLite database path inside the server container
# Persisted via Docker named volume `rdp-server-data` mounted at /app/data
DATABASE_URL=file:./data/app.db

# Host folder for shared-drive files (mounted into server + guacd)
DRIVES_PATH=D:/rdp_shared

# --- Security (REQUIRED — do not leave blank in production) ---
# Minimum 32 characters each. Use unique random values.
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
VM_ENCRYPTION_KEY=
# Guacamole WebSocket encryption key (defaults to VM_ENCRYPTION_KEY if unset)
ENCRYPTION_KEY=

# --- JWT lifetimes (optional) ---
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# --- CORS / public URL (optional) ---
# Set to the URL users use to access the application, e.g. https://rdp.example.com
CORS_ORIGIN=http://localhost

# --- Demo data seeding (NOT recommended for production) ---
# When true, creates default admin/guest accounts and a sample VM on first startup.
# Leave false and use the web setup wizard at /setup instead.
AUTO_SEED=false

# --- Pre-built Docker images (optional) ---
# Leave commented to build images locally from source.
# BACKEND_IMAGE=ghcr.io/atvriders/rdp-in-browser-server:prod
# FRONTEND_IMAGE=ghcr.io/atvriders/rdp-in-browser-frontend:prod
