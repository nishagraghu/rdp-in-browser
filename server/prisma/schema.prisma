generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String             @id @default(uuid())
  name         String
  email        String             @unique
  username     String             @unique
  passwordHash String
  role         String             @default("USER")
  isActive     Boolean            @default(true)
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  assignments  VMUserAssignment[]
  refreshTokens RefreshToken[]
  auditLogs    AuditLog[]
}

model VM {
  id                String             @id @default(uuid())
  name              String
  description       String?
  protocol          String             @default("RDP")
  hostname          String
  port              Int                @default(3389)
  // Seconds to wait for the RDP handshake before failing the session
  connectionTimeout Int                @default(15)
  username          String
  encryptedPassword String
  domain            String?
  isActive          Boolean            @default(true)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  assignments       VMUserAssignment[]

  // Access schedule (Guacamole-style restrictions)
  // Times stored as "HH:mm" (24h); dates as "YYYY-MM-DD". Empty/null = no restriction.
  allowAccessAfter      String?
  doNotAllowAccessAfter String?
  enableAccountAfter    String?
  disableAccountAfter   String?

  // Device Redirection (Audio)
  supportAudioInConsole Boolean @default(false)
  disableAudio          Boolean @default(false)
  enableAudioInput      Boolean @default(false)

  // Device Redirection (Printing) — print jobs are PDF'd and sent to the browser user's local printers
  enablePrinting        Boolean @default(true)
  printerName           String?

  // Device Redirection (Drive)
  enableDrive           Boolean @default(false)
  driveName             String?
  disableFileDownload   Boolean @default(false)
  disableFileUpload     Boolean @default(false)
  drivePath             String?
  createDrivePath       Boolean @default(false)
  // One existing host folder shared by every user. The app does not create it.
  commonDrive           Boolean @default(false)
  
  // Channels
  staticChannelNames    String?

  // Clipboard (Guacamole)
  normalizeClipboard    String  @default("preserve") // preserve | unix | windows
  disableCopy           Boolean @default(false)
  disablePaste          Boolean @default(false)

  // Display (Guacamole RDP)
  displayWidth          Int?
  displayHeight         Int?
  dpi                   Int?
  colorDepth            Int      @default(32)
  forceLossless         Boolean  @default(false)
  resizeMethod          String   @default("display-update")
  readOnly              Boolean  @default(false)

  // Performance (Guacamole RDP)
  enableWallpaper           Boolean @default(false)
  enableTheming             Boolean @default(false)
  enableFontSmoothing       Boolean @default(true)
  enableFullWindowDrag      Boolean @default(false)
  enableDesktopComposition  Boolean @default(false)
  enableMenuAnimations      Boolean @default(false)
  disableBitmapCaching      Boolean @default(false)
  disableOffscreenCaching   Boolean @default(false)
  disableGlyphCaching       Boolean @default(false)
  disableGfx                Boolean @default(false)
}

model VMUserAssignment {
  id        String   @id @default(uuid())
  vmId      String
  userId    String
  createdAt DateTime @default(now())

  vm   VM   @relation(fields: [vmId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([vmId, userId])
}

model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  userName  String?
  action    String
  details   String?
  ipAddress String?
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)
}

/// Singleton-style app branding settings (id is always "default").
model AppSettings {
  id               String   @id @default("default")
  logoFileName     String?
  logoOriginalName String?
  logoMimeType     String?
  logoPath         String?
  updatedAt        DateTime @updatedAt
  updatedById      String?
}
