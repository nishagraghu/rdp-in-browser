# =============================================================================
# rdp-in-browser — Environment Configuration
# =============================================================================
# 1. Copy this file to `.env`
# 2. Fill in the three required secrets below (32+ characters each)
# 3. Run: docker compose up -d
#
# Generate secrets:
#   Linux/macOS:   openssl rand -base64 48
#   PowerShell:    [Convert]::ToBase64String((1..48 | ForEach-Object { Get-Random -Maximum 256 }))
# =============================================================================

NODE_ENV=production

# Web port on your server (default 80)
HTTP_PORT=80

# Backend (do not change unless instructed)
PORT=3001
DATABASE_URL=file:/app/data/app.db

# Host folder for shared-drive files (mounted into server + guacd)
# SQLite app data uses Docker named volume `rdp-server-data` (see docker-compose.yml)
DRIVES_PATH=D:/rdp_shared

# --- REQUIRED: set unique random values (minimum 32 characters each) ---
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
VM_ENCRYPTION_KEY=

# Optional: Guacamole WebSocket encryption (defaults to VM_ENCRYPTION_KEY)
# ENCRYPTION_KEY=

# Optional: public URL users type in the browser (e.g. https://rdp.yourcompany.com)
# CORS_ORIGIN=http://localhost

# Optional: JWT lifetimes
# JWT_ACCESS_EXPIRES_IN=15m
# JWT_REFRESH_EXPIRES_IN=7d

# Leave false in production — use the /setup wizard instead
AUTO_SEED=false

# Pre-built images (change only if your vendor gave you different image names)
BACKEND_IMAGE=ghcr.io/atvriders/rdp-in-browser-server:prod
FRONTEND_IMAGE=ghcr.io/atvriders/rdp-in-browser-frontend:prod
